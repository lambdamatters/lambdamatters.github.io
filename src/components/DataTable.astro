---
interface Props {
  tableData: {
    title: string;
    caption?: string;
    headers: string[];
    rows: string[][];
  };
}

const { tableData } = Astro.props;
---

<div class="data-table-container">
  <div class="table-header-block">
    <h3 class="table-title">{tableData.title}</h3>
    {tableData.caption && <p class="table-caption">{tableData.caption}</p>}
  </div>

  <div class="table-scroll-wrapper">
    <table class="editorial-table">
      <thead>
        <tr>
          {tableData.headers.map((h, i) => (
            <th scope="col" class={i === 0 ? 'text-left' : 'text-right'}>{h}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {tableData.rows.map((row) => (
          <tr>
            {row.map((cell, i) => (
              <td class={i === 0 ? 'row-label' : 'row-val text-right'}>
                {cell}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .data-table-container {
    margin: 1.75rem 0;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  .table-header-block {
    margin-bottom: 0.85rem;
  }

  .table-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.35rem 0;
    color: var(--text);
  }

  .table-caption {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  .table-scroll-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: 0.75rem;
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  th {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  td {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.05));
    color: var(--text);
  }

  tr:last-child td {
    border-bottom: 1px solid var(--border);
  }

  .text-left {
    text-align: left;
  }

  .text-right {
    text-align: right;
  }

  .row-label {
    font-family: var(--font-serif);
    font-weight: 500;
    white-space: nowrap;
  }

  .row-val {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    th, td {
      padding: 0.5rem 0.5rem;
      font-size: 0.8rem;
    }
  }
</style>
