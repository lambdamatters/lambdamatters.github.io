---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportCard from '../components/ReportCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExtrapolationChart from '../components/ExtrapolationChart.astro';
import LifecycleDiagram from '../components/LifecycleDiagram.astro';

const reports = await getCollection('reports');
reports.sort((a, b) => a.data.order - b.data.order);

const projects = [
  {
    id: 'compitent',
    title: 'Compitent',
    titleUrl: 'https://github.com/vijayanant/compiled-intent',
    tag: 'Systems Architecture · Rust MCP',
    description: 'A headless architectural coprocessor and Model Context Protocol (MCP) server written in Rust that compiles design intent into synchronized Apache Arrow and LanceDB indices.',
    features: [
      { label: 'AST-Bounded Parent-Child Chunking', text: 'Streaming Markdown parser ensures 300-character child vectors never cross structural section headers, delivering complete parent headings in a single zero-hop pass.' },
      { label: 'Hybrid RRF Retrieval', text: 'Combines dense vector search with Tantivy BM25 full-text keyword indexing, fusing results via Reciprocal Rank Fusion to balance conceptual rules and exact code identifiers.' },
      { label: 'Live Cache Invalidation', text: 'Maintains SHA-256 manifests across workspace specs, purging and rebuilding only modified file vectors in milliseconds to eliminate stale context.' },
    ],
    links: [
      { label: 'Engine Source (Rust) ↗', url: 'https://github.com/vijayanant/compiled-intent' },
      { label: 'ArchEval Benchmarks ↗', url: 'https://github.com/vijayanant/compiled-intent-research' },
    ],
  },
  {
    id: 'akshara',
    title: 'Akshara',
    titleUrl: 'https://github.com/vijayanant/akshara',
    tag: 'Cryptography · Distributed Systems',
    description: 'An offline-first, encrypted data architecture for collaborative state and sovereign data without trusted central servers.',
    features: [
      { label: 'Content-Addressed Merkle-DAGs', text: 'Deterministic DAG-CBOR state graphs with causal reconciliation independent of wall-clock time.' },
      { label: 'Hierarchical Deterministic Identity', text: 'BIP-32-style master seed derivation providing functional branch isolation and key revocation walking.' },
      { label: 'Topology-Independent Secrecy', text: 'Content-blind synchronization using XChaCha20-Poly1305 authenticated encryption, enabling sovereign data flow across untrusted relays.' },
    ],
    links: [
      { label: 'Core Architecture (Rust) ↗', url: 'https://github.com/vijayanant/akshara' },
      { label: 'Architecture Series ↗', url: 'https://vijayanant.com/series/exploring-the-sovereign-web/' },
    ],
  },
  {
    id: 'autocombo',
    title: 'AutoCombo',
    tag: 'Discrete Mathematics · Algorithms',
    description: 'An algorithm by Raghu Ugare and Vijay Ananth showing how numbers serve as efficient data structures. By mapping product catalogs to prime numbers, multiset containment collapses from dynamic programming into integer divisibility.',
    features: [
      { label: 'Prime Factorization Mapping', text: 'Assigns a unique prime number $p_i$ to each product. Shopping carts and combo offers become unique composite numbers $S$ and $C_j$ via the Fundamental Theorem of Arithmetic.' },
      { label: 'Constant-Time Containment Check', text: 'Sub-multiset containment collapses into a single integer modulo divisibility test: $S \\equiv 0 \\pmod{C_j}$.' },
      { label: 'Quotient Continuation', text: 'Dividing the cart composite by the combo composite ($S / C_j$) leaves the exact remaining product state for evaluating secondary discounts.' },
    ],
    links: [
      { label: 'Technical Monograph (PDF) ↗', url: '/files/An_Algorithm_for_AutoCombo.pdf' },
    ],
  },
];
---

<BaseLayout
  title="LambdaMatters"
  description="Systems Architecture · Distributed Systems · Applied AI"
  isHome={true}
  footerBackLink={{ href: '/about/', label: 'About the Studio →' }}
  footerEmail="contact@lambdamatters.com"
>
  <main>
    <!-- Section: The Thesis -->
    <section class="section section-thesis">
      <div class="thesis-block">
        <span class="section-label">Our Thesis</span>
        <h2 class="thesis-heading">The interesting problems live between disciplines.</h2>
        <p class="thesis-body">
          Mathematics gives us language and structure. Functional programming makes that structure executable. Systems research confronts those ideas with state, distribution, and failure. Machine learning brings empirical search, probabilistic models, and agent workflows. LambdaMatters exists at their intersections.
        </p>
      </div>
    </section>

    <!-- Section: Research Reports -->
    <section class="section" id="reports">
      <h2 class="section-title">Research Reports</h2>
      {reports.map((report) => (
        <ReportCard report={report}>
          {report.id === 'newton-reborn' && <ExtrapolationChart slot="visual" />}
          {report.id === 'compiled-intent' && <LifecycleDiagram slot="visual" />}
        </ReportCard>
      ))}
    </section>

    <!-- Section: Systems & Protocols -->
    <section class="section" id="systems">
      <h2 class="section-title">Systems & Protocols</h2>
      <div class="project-grid">
        {projects.map((proj) => (
          <ProjectCard
            id={proj.id}
            title={proj.title}
            titleUrl={proj.titleUrl}
            tag={proj.tag}
            description={proj.description}
            features={proj.features}
            links={proj.links}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .thesis-block {
    margin-bottom: 0.5rem;
  }

  .thesis-heading {
    font-size: 2.15rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0.35rem 0 1rem 0;
  }

  .thesis-body {
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 65ch;
    margin: 0;
  }

  .project-grid {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 640px) {
    .thesis-heading {
      font-size: 1.75rem;
    }
    .thesis-body {
      font-size: 1rem;
    }
  }
</style>
