---
interface Props {
  backLink?: {
    href: string;
    label: string;
  };
  email?: string;
  style?: string;
}

const {
  backLink = { href: '/about/', label: 'About the Studio →' },
  email = 'contact@lambdamatters.com',
  style,
} = Astro.props;
---

<footer class="site-footer" style={style}>
  <div class="footer-item footer-item-left">
    {backLink && (
      <a href={backLink.href} class="footer-nav-link">{backLink.label}</a>
    )}
  </div>
  <div class="footer-item footer-item-center">
    <span class="footer-contact">
      Inquiries: <a href={`mailto:${email}`}>{email}</a>
    </span>
  </div>
  <div class="footer-item footer-item-right">
    <span class="footer-copy">© 2026 LambdaMatters.</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .site-footer {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 1rem;
    }
  }

  .footer-item-left {
    text-align: left;
  }

  .footer-item-center {
    text-align: center;
  }

  .footer-item-right {
    text-align: right;
  }

  .footer-nav-link {
    color: var(--muted);
  }

  .footer-contact {
    color: var(--muted);
  }

  .footer-contact a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
  }

  .footer-copy {
    color: var(--faint);
  }
</style>
