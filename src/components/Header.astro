---
import Logo from './Logo.astro';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<header class="site-header">
  <div class="brand-lockup">
    {isHome ? (
      <div class="brand-content">
        <Logo />
        <div class="brand-text">
          <h1 class="brand-name">LambdaMatters</h1>
          <p class="tagline">Systems Architecture · Distributed Systems · Applied AI</p>
        </div>
      </div>
    ) : (
      <a href="/" class="brand-link">
        <Logo />
        <div class="brand-text">
          <h1 class="brand-name">LambdaMatters</h1>
          <p class="tagline">Systems Architecture · Distributed Systems · Applied AI</p>
        </div>
      </a>
    )}
  </div>
</header>

<style>
  .site-header {
    margin-bottom: 3.5rem;
  }

  .brand-lockup {
    display: inline-block;
  }

  .brand-content,
  .brand-link {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    text-decoration: none;
    color: inherit;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand-name {
    font-size: 1.65rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.1;
    margin: 0;
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.02em;
    margin: 0;
  }

  @media (max-width: 640px) {
    .site-header {
      margin-bottom: 2rem;
    }
    .brand-content,
    .brand-link {
      gap: 0.85rem;
    }
    .brand-name {
      font-size: 1.35rem;
    }
    .tagline {
      font-size: 0.7rem;
    }
  }
</style>
