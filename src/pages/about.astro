---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarItem from '../components/PillarItem.astro';

const pillars = [
  {
    symbol: 'Σ',
    title: 'Mathematics & foundations',
    description: 'Discrete mathematics, probability, linear algebra, geometry, category-inspired thinking, and computational exploration.',
  },
  {
    symbol: '∂',
    title: 'AI & machine learning',
    description: 'Reliable AI systems, generative models, symbolic discovery, and empirical evaluation.',
  },
  {
    symbol: '⇄',
    title: 'Systems & protocols',
    description: 'Distributed state, offline-first systems, cryptographic identity, verifiable architecture, and enforceable design intent.',
  },
  {
    symbol: 'λ',
    title: 'Functional & systems programming',
    description: 'Haskell, Rust, expressive type systems, memory safety, and compositional design.',
  },
];
---

<BaseLayout
  title="About | LambdaMatters"
  description="Systems Architecture · Distributed Systems · Applied AI"
  isHome={false}
  footerBackLink={{ href: '/', label: '← Back to Research' }}
  footerEmail="hello@lambdamatters.com"
>
  <main>
    <!-- Section 1: About the Studio -->
    <section class="section">
      <h2 class="section-title">About the Studio</h2>
      <div class="origins-card">
        <p class="origins-lead">
          LambdaMatters is an independent systems research studio investigating the intersections of mathematics, AI/ML, distributed systems, and functional programming.
        </p>
        <p class="origins-body">
          We operate outside traditional corporate product cycles and academic tenure tracks. This independence allows us to focus entirely on foundational questions: how to enforce invariants on autonomous software, how to verify decentralized state, and how mathematical rigor transforms software engineering.
        </p>
      </div>
    </section>

    <!-- Section 2: Core Disciplines -->
    <section class="section">
      <h2 class="section-title">Core Disciplines</h2>
      <div class="disciplines-grid">
        {pillars.map((pillar) => (
          <PillarItem
            symbol={pillar.symbol}
            title={pillar.title}
            description={pillar.description}
          />
        ))}
      </div>
    </section>

    <!-- Section 3: Origins & Trajectory -->
    <section class="section">
      <h2 class="section-title">Origins &amp; Trajectory</h2>
      <div class="origins-card">
        <p class="origins-sub">
          The studio grew out of an ongoing collaboration exploring programming language semantics, discrete mathematics, and system architectures. What began with early investigations into prime multiset algorithms (AutoCombo) and conference demonstrations on category theory and generalized algebraic data types (GADTs) evolved into an open research effort spanning symbolic physics, architectural coprocessors, and sovereign computing protocols.
        </p>

        <div class="timeline-block">
          <ul class="timeline-list">
            <li>
              <strong>2010s:</strong> Early explorations in language design, discrete mathematics, and the AutoCombo prime multiset algorithm.
            </li>
            <li>
              <strong>2018:</strong> <em>(Why?) Should You Know Category Theory?</em> (Functional Conf, Bengaluru).
              <a href="/files/category-theory.pdf" class="talk-link" target="_blank" rel="noopener">Slides (PDF) ↗</a>
            </li>
            <li>
              <strong>2019:</strong> <em>Have You GADT? GADTs for Eliminating Runtime Checks</em> (Functional Conf, Bengaluru).
              <a href="/files/gadt.pdf" class="talk-link" target="_blank" rel="noopener">Slides (PDF) ↗</a>
            </li>
            <li>
              <strong>Today:</strong> Active research reports (Newton Reborn, Compiled Intent) and distributed protocols (Akshara).
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section 4: Contact & Inquiries -->
    <section class="section">
      <h2 class="section-title">Contact &amp; Inquiries</h2>
      <div class="origins-card">
        <div class="collab-note">
          <p>
            Alongside our open research and systems, we occasionally collaborate with select teams on hard foundational problems in systems architecture, distributed state, and applied machine learning.
          </p>
          <p class="collab-action">
            For technical inquiries: <a href="mailto:hello@lambdamatters.com">hello@lambdamatters.com</a>
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .origins-card {
    padding: 0;
    background: transparent;
    border: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .origins-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
    margin: 0;
  }

  .origins-body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }

  .origins-sub {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }

  .disciplines-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .timeline-block {
    margin-top: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border);
  }

  .timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .timeline-list li {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text);
    padding-left: 1.25rem;
    position: relative;
  }

  .timeline-list li::before {
    content: "·";
    position: absolute;
    left: 0.25rem;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--muted);
  }

  .timeline-list strong {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    margin-right: 0.35rem;
  }

  .talk-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    margin-left: 0.5rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
  }

  .collab-note {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .collab-note p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  .collab-action {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--muted);
  }

  .collab-action a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
  }

  @media (max-width: 640px) {
    .disciplines-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
