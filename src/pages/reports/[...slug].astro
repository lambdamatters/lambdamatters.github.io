---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetricsGrid from '../../components/MetricsGrid.astro';
import BibtexDrawer from '../../components/BibtexDrawer.astro';
import DataTable from '../../components/DataTable.astro';
import ReferencesList from '../../components/ReferencesList.astro';
import ExtrapolationChart from '../../components/ExtrapolationChart.astro';
import LifecycleDiagram from '../../components/LifecycleDiagram.astro';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((report) => ({
    params: { slug: report.id },
    props: { report },
  }));
}

const { report } = Astro.props;
const { data } = report;
const { Content } = await render(report);
---

<BaseLayout
  title={`${data.title} | LambdaMatters`}
  description={`LambdaMatters ${data.reportNumber}: ${data.title}`}
  ogType="article"
  isHome={false}
  footerBackLink={{ href: '/#reports', label: '← Back to All Reports' }}
>
  <main class="dossier">
    <!-- Dossier Header -->
    <header class="dossier-header">
      <div class="dossier-badge-row">
        <span class="report-badge">{data.reportType || 'Technical Report'}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="report-id">{data.reportNumber}</span>
        <span class="sep" aria-hidden="true">·</span>
        <time datetime={data.date}>{data.formattedDate}</time>
        <span class="sep" aria-hidden="true">·</span>
        <span class="dossier-tag">{data.disciplines}</span>
      </div>

      <h1 class="dossier-title">{data.title}</h1>

      <div class="dossier-byline">
        <span class="byline-label">Author:</span>
        {data.authorUrl ? (
          <a href={data.authorUrl} class="author-name">{data.author}</a>
        ) : (
          <span class="author-name">{data.author}</span>
        )}
        <span class="author-org">· LambdaMatters Research Studio</span>
      </div>

      <!-- Action Links: Immediately Accessible at Top -->
      <div class="action-links header-actions">
        {data.isComingSoon ? (
          <span class="btn btn-secondary disabled" title="Release repository coming soon">
            {data.comingSoonText || 'Release Coming Soon'}
          </span>
        ) : (
          <>
            {data.downloadUrl && (
              <a href={data.downloadUrl} class="btn btn-primary" target="_blank" rel="noopener">
                {data.downloadLabel}
              </a>
            )}
            {data.repoUrl && (
              <a href={data.repoUrl} class="btn btn-secondary" target="_blank" rel="noopener">
                {data.repoLabel || 'Repository ↗'}
              </a>
            )}
            {data.benchmarkUrl && (
              <a href={data.benchmarkUrl} class="btn btn-secondary" target="_blank" rel="noopener">
                {data.benchmarkLabel || 'Benchmark Suite ↗'}
              </a>
            )}
            {data.authorEssayUrl && (
              <a href={data.authorEssayUrl} class="btn btn-secondary" target="_blank" rel="noopener">
                {data.authorEssayLabel || "Author's Technical Essay ↗"}
              </a>
            )}
          </>
        )}
      </div>
    </header>

    <!-- Key Empirical Metrics (Executive Highlights) -->
    <section class="dossier-section">
      <h2 class="section-title">Verified Empirical Results</h2>
      <MetricsGrid metrics={data.metrics} />
    </section>

    <!-- Research Analysis & Findings (Clean Typography) -->
    <section class="dossier-section">
      <h2 class="section-title">Research Findings & Analysis</h2>
      <div class="dossier-prose">
        <Content />
      </div>
    </section>

    <!-- Visual Architecture / Extrapolation Chart -->
    {report.id === 'newton-reborn' && (
      <section class="dossier-section">
        <h2 class="section-title">Empirical Extrapolation Breakdown</h2>
        <ExtrapolationChart />
      </section>
    )}
    {report.id === 'compiled-intent' && (
      <section class="dossier-section">
        <h2 class="section-title">Dual-Engine Verification Architecture</h2>
        <LifecycleDiagram />
      </section>
    )}

    <!-- Comparative Benchmark Data Table -->
    {data.tableData && (
      <section class="dossier-section">
        <DataTable tableData={data.tableData} />
      </section>
    )}

    <!-- Formal Academic References -->
    {data.references && (
      <section class="dossier-section">
        <ReferencesList references={data.references} />
      </section>
    )}

    <!-- BibTeX Citation -->
    <section class="dossier-section">
      <BibtexDrawer bibtex={data.bibtex} bibtexId={data.bibtexId} />
    </section>
  </main>
</BaseLayout>

<style>
  .dossier {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  .dossier-header {
    margin-bottom: 2.5rem;
  }

  .dossier-badge-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .report-badge {
    background: var(--badge-bg);
    color: var(--badge-text);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .report-id {
    color: var(--accent);
    font-weight: 500;
  }

  .dossier-tag {
    color: var(--accent);
  }

  .dossier-title {
    font-size: 2.2rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 1rem 0;
  }

  .dossier-byline {
    font-size: 1rem;
    color: var(--muted);
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .byline-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
  }

  .author-name {
    color: var(--text);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
  }

  .author-org {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .dossier-section {
    margin-bottom: 3rem;
  }

  .header-actions {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .dossier-prose {
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--text);
  }

  .dossier-prose :global(p) {
    margin-bottom: 1.4rem;
  }

  .dossier-prose :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .dossier-prose :global(h3:first-child) {
    margin-top: 0;
  }

  .dossier-prose :global(ol),
  .dossier-prose :global(ul) {
    margin: 1.1rem 0 1.6rem 1.75rem;
    padding-left: 0.25rem;
  }

  .dossier-prose :global(li) {
    margin-bottom: 0.85rem;
    line-height: 1.75;
  }

  .dossier-prose :global(strong) {
    font-weight: 600;
    color: var(--text);
  }

  .dossier-prose :global(.katex-display) {
    margin: 1.6rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0;
  }

  .action-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  @media (max-width: 640px) {
    .dossier-title {
      font-size: 1.75rem;
    }
  }
</style>
