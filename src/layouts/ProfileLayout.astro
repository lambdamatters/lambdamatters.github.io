---
import BaseLayout from './BaseLayout.astro';
import QrDrawer from '../components/QrDrawer.astro';

interface ProfileLink {
  label: string;
  url: string;
}

interface Props {
  name: string;
  role: string;
  bio: string;
  email: string;
  vcfPath: string;
  vcfFileName: string;
  qrPath: string;
  writingUrl: string;
  writingLabel: string;
  profiles: ProfileLink[];
  metaDescription: string;
}

const {
  name,
  role,
  bio,
  email,
  vcfPath,
  vcfFileName,
  qrPath,
  writingUrl,
  writingLabel,
  profiles,
  metaDescription,
} = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  jobTitle: role,
  worksFor: {
    '@type': 'Organization',
    name: 'LambdaMatters',
    url: 'https://lambdamatters.com',
  },
  email: `mailto:${email}`,
  url: new URL(Astro.url.pathname, 'https://lambdamatters.com').href,
  description: bio,
  sameAs: profiles.map((p) => p.url).concat(writingUrl).filter(Boolean),
};
---

<BaseLayout
  title={`${name} | LambdaMatters`}
  description={metaDescription}
  ogType="profile"
  isHome={false}
  footerBackLink={{ href: '/', label: '← Back to LambdaMatters Studio' }}
  footerEmail="contact@lambdamatters.com"
  footerStyle="margin-top: 4rem;"
  jsonLd={personSchema}
>
  <main class="profile-hero">
    <div class="profile-header-group">
      <h1 class="profile-name">{name}</h1>
      <p class="profile-role">{role}</p>
    </div>

    <p class="profile-bio">{bio}</p>

    <section class="profile-contact-list" aria-label="Contact and presence">
      <div class="contact-row">
        <span class="contact-label">Email</span>
        <div class="contact-value">
          <a href={`mailto:${email}`}>{email}</a>
        </div>
      </div>

      <div class="contact-row">
        <span class="contact-label">Card</span>
        <div class="contact-value">
          <a href={vcfPath} download={vcfFileName}>Download vCard &darr;</a>
          <span class="sep" aria-hidden="true">&middot;</span>
          <QrDrawer qrPath={qrPath} name={name} />
        </div>
      </div>

      <div class="contact-row">
        <span class="contact-label">Writing</span>
        <div class="contact-value">
          <a href={writingUrl} target="_blank" rel="noopener">{writingLabel}</a>
        </div>
      </div>

      <div class="contact-row">
        <span class="contact-label">Profiles</span>
        <div class="contact-value">
          {profiles.map((link, idx) => (
            <>
              {idx > 0 && <span class="sep" aria-hidden="true">&middot;</span>}
              <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
            </>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .profile-hero {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .profile-header-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .profile-name {
    font-size: 2.1rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }

  .profile-role {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin: 0;
  }

  .profile-bio {
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--text);
    max-width: 62ch;
    margin: 0;
  }

  .profile-contact-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }

  .contact-row {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    width: 75px;
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-value {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .contact-value a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
  }

  .sep {
    color: var(--border);
  }

  @media (max-width: 640px) {
    .profile-hero {
      padding-top: 1.25rem;
      gap: 1.2rem;
    }
    .profile-name {
      font-size: 1.85rem;
    }
    .contact-row {
      gap: 0.85rem;
    }
    .contact-label {
      width: 65px;
    }
  }
</style>
