---
interface Props {
  references: string[];
}

const { references } = Astro.props;
---

<div class="references-block">
  <h3 class="references-title">Formal References</h3>
  <ol class="references-list">
    {references.map((ref) => (
      <li class="reference-item">{ref}</li>
    ))}
  </ol>
</div>

<style>
  .references-block {
    margin: 2rem 0;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  .references-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.85rem 0;
    color: var(--text);
  }

  .references-list {
    margin: 0;
    padding-left: 1.35rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .reference-item {
    margin-bottom: 0.5rem;
  }

  .reference-item:last-child {
    margin-bottom: 0;
  }
</style>
