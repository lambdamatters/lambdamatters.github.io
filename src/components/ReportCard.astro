---
import { render } from 'astro:content';
import katex from 'katex';
import MetricsGrid from './MetricsGrid.astro';

interface Props {
  report: any;
}

const { report } = Astro.props;
const { data, id } = report;
const { Content } = await render(report);
const dossierUrl = `/reports/${id}/`;

function formatSummaryMath(text: string): string {
  return text.replace(/\$([^$]+)\$/g, (_, math) => {
    return katex.renderToString(math, { throwOnError: false });
  });
}

const summaryHtml = data.summary ? formatSummaryMath(data.summary) : null;
---

<article class="report-card" id={id}>
  <div class="report-meta">
    <span class="badge">{data.reportType || 'Technical Report'}</span>
    <span class="sep" aria-hidden="true">·</span>
    <span class="accession-code">{data.reportNumber}</span>
    <span class="sep" aria-hidden="true">·</span>
    <time datetime={data.date}>{data.formattedDate}</time>
    <span class="sep" aria-hidden="true">·</span>
    <span class="intersection-tag">{data.disciplines}</span>
  </div>

  <h3 class="report-title">
    <a href={dossierUrl}>{data.title}</a>
  </h3>

  <p class="report-author">
    {data.authorUrl ? (
      <a href={data.authorUrl}>{data.author}</a>
    ) : (
      data.author
    )}
  </p>

  <div class="report-abstract">
    {summaryHtml ? (
      <p class="summary-paragraph" set:html={summaryHtml} />
    ) : (
      <Content />
    )}
  </div>

  <slot name="visual" />

  <MetricsGrid metrics={data.metrics} />

  <div class="card-footer-row">
    <a href={dossierUrl} class="dossier-cta">
      Read Full Dossier &rarr;
    </a>
    {data.downloadUrl && (
      <a href={data.downloadUrl} class="pdf-download-link" target="_blank" rel="noopener">
        Download PDF ↗
      </a>
    )}
  </div>
</article>

<style>
  .report-card {
    padding: 0 0 1rem 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  :global(.report-card + .report-card) {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .report-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--faint);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .badge {
    background: var(--badge-bg);
    color: var(--badge-text);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .accession-code {
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 500;
  }

  .intersection-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .sep {
    color: var(--border);
  }

  .report-title {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .report-author {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .report-author a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px dotted var(--muted);
    transition: all 0.15s ease;
  }

  .report-author a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .report-abstract {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text);
  }

  .summary-paragraph {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0 0 1rem 0;
  }

  .card-footer-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.25rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
  }

  .dossier-cta {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--accent);
    transition: all 0.15s ease;
  }

  .dossier-cta:hover {
    color: var(--accent);
    text-decoration-color: var(--text);
  }

  .pdf-download-link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .report-title {
      font-size: 1.25rem;
    }
    .card-footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
