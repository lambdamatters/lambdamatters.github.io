---
interface Props {
  backLink?: {
    href: string;
    label: string;
  };
  email?: string;
  style?: string;
}

const {
  backLink = { href: '/about/', label: 'About the Studio →' },
  email = 'contact@lambdamatters.com',
  style,
} = Astro.props;
---

<footer class="site-footer" style={style}>
  {backLink && (
    <div class="footer-links">
      <a href={backLink.href}>{backLink.label}</a>
    </div>
  )}
  <div class="footer-contact">
    Inquiries: <a href={`mailto:${email}`}>{email}</a>
  </div>
  <div class="footer-copy">
    © 2026 LambdaMatters.
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .footer-links a {
    color: var(--muted);
  }

  .footer-contact a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--faint);
  }
</style>
