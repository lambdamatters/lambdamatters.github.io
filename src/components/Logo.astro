---
interface Props {
  width?: number | string;
  height?: number | string;
  class?: string;
}

const {
  width = 62,
  height = 50,
  class: className = 'logo',
} = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 120 100"
  width={width}
  height={height}
  fill="none"
  role="img"
  aria-label="LambdaMatters Logo"
>
  <defs>
    <mask id="site-interlock-gap">
      <rect width="120" height="100" fill="#ffffff" />
      <path
        d="M 73 44 C 65 54, 59 68, 51 79 L 60 79 C 65 68, 71 56, 76 47 Z"
        fill="#000000"
        stroke="#000000"
        stroke-width="7"
        stroke-linejoin="round"
      />
    </mask>
  </defs>
  <g fill="currentColor">
    <g mask="url(#site-interlock-gap)">
      <path d="M 36 22 C 37 28, 45 60, 57 78 L 50 78 C 42 62, 34 38, 33 26 Z" />
      <path d="M 35 44 C 27 54, 21 68, 14 78 L 21 78 C 26 68, 32 56, 37 47 Z" />
    </g>
    <path d="M 74 22 C 75 28, 83 60, 95 78 L 88 78 C 80 62, 72 38, 71 26 Z" />
    <path d="M 73 44 C 65 54, 59 68, 52 78 L 59 78 C 64 68, 70 56, 75 47 Z" />
  </g>
</svg>
