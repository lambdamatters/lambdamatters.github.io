---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  isHome?: boolean;
  footerBackLink?: {
    href: string;
    label: string;
  };
  footerEmail?: string;
  footerStyle?: string;
  hideFooter?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'LambdaMatters',
  description = 'Independent research studio investigating the intersections of systems architecture, distributed state, and applied AI.',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://lambdamatters.com').href,
  ogType = 'website',
  ogImage = 'https://lambdamatters.com/og-image.png',
  isHome = false,
  footerBackLink,
  footerEmail,
  footerStyle,
  hideFooter = false,
  jsonLd,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  
  <!-- Open Graph -->
  <meta property="og:site_name" content="LambdaMatters">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:type" content={ogType}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@lambdamatters">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Structured Data (JSON-LD) -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  
  <!-- Master Typography: Newsreader & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap">
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
  
  <!-- Head Theme Detection: Prevents FOUC -->
  <script is:inline>
    (function() {
      let saved = null;
      try { saved = localStorage.getItem('theme'); } catch (e) {}
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body>
  <ThemeToggle />

  <div class="container">
    <Header isHome={isHome} />

    <slot />

    {!hideFooter && (
      <Footer backLink={footerBackLink} email={footerEmail} style={footerStyle} />
    )}
  </div>
</body>
</html>
